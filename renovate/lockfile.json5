{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Monthly lock file maintenance and suppression of non-breaking Rust, JavaScript, and Python update PRs.",
  "extends": [
    "github>martinohmann/.github//renovate/base.json5"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "extends": ["schedule:monthly"]
  },
  "packageRules": [
    {
      "matchCategories": ["rust", "js", "python"],
      "matchJsonata": ["isBreaking != true"],
      "enabled": false
    }
  ]
}
